# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact email (optional). Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Social links (https only; blank = shown as "coming soon") ─────────
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@foundingvfx8
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ─── Data ─────────────────────────────────────────────────────────────
# sample = built-in demo content. database = Supabase (run npm run db:migrate && npm run db:seed first).
DATA_SOURCE=sample

# ─── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Transaction pooler (port 6543). Keep ?pgbouncer=true at the end.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Connect → Session pooler (port 5432). Used for migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# How long the public site caches content between database reads (ms).
CONTENT_SNAPSHOT_TTL_MS=30000
# Must exceed the queries one page runs in parallel.
DATABASE_POOL_MAX=12

# ─── Feature flags (only enable once the backing system exists) ───────
FEATURE_ANALYTICS=false
FEATURE_ACCOUNTS=false
FEATURE_REQUEST_SUBMISSIONS=false

# ─── Security ─────────────────────────────────────────────────────────
# Random secret used to hash client identifiers for rate limiting.
RATE_LIMIT_SALT=change-me

# ─── Metadata import (admin) ──────────────────────────────────────────
# themoviedb.org → Settings → API → API Read Access Token.
# Lets the admin prefill show details, artwork and cast. Optional.
TMDB_API_KEY=

# ─── Storage providers (server-only secrets) ──────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Public host for uploaded artwork, used by next/image (e.g. assets.example.com)
NEXT_PUBLIC_ASSET_HOST=

# ─── Monetization (off by default) ────────────────────────────────────
MONETIZATION_ADS=false
MONETIZATION_DOWNLOAD_MODE=direct
MONETIZATION_LINKVERTISE=false
MONETIZATION_INTERSTITIAL=false
LINKVERTISE_PUBLISHER_ID=
